# ============================================================
# ヌリエル 環境変数設定
# このファイルを .env にコピーして値を設定してください
# ============================================================

# --- Replicate API（ControlNet線画変換） ---
# https://replicate.com/account/api-tokens で取得
REPLICATE_API_TOKEN=

# --- Stripe 決済 ---
# https://dashboard.stripe.com/apikeys で取得
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- セッション管理 ---
# セッショントークンの署名に使用（ランダム文字列を設定）
JWT_SECRET=

# --- フロントエンドURL ---
# CORS許可対象のオリジン
FRONTEND_URL=http://localhost:3000

# --- Cloudflare D1 ---
# ローカル開発時は wrangler dev が自動バインドするため不要
# D1_DATABASE_ID=

# --- Cloudflare R2 ---
# ローカル開発時は wrangler dev が自動バインドするため不要
# R2_BUCKET_NAME=nuriel-storage
